{
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh script/run-in-env.sh camas mcp fix"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh script/run-in-env.sh camas mcp fix"
          },
          {
            "type": "command",
            "command": "sh script/run-in-env.sh camas mcp gate --nudge",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
